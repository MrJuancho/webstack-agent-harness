import Fastify, { FastifyInstance, RouteOptions } from 'fastify';
import swagger from '@fastify/swagger';
import swaggerUi from '@fastify/swagger-ui';
import { TypeBoxTypeProvider } from '@fastify/type-provider-typebox';
import { Type } from '@sinclair/typebox';
import type { UseCases } from '../application/use-cases.js';
import { buildUseCases } from '../composition.js';
import { requireAuth } from './auth.js';
import { ErrorResponse } from './errors.js';
import { taskRoutes } from './routes/tasks.js';

// Declaración de tipos para metadata de rutas
declare module 'fastify' {
  interface FastifyContextConfig {
    isPublic?: boolean;
  }
}

// Re-exportados desde acá por compatibilidad: los tests de arquitectura
// los importan de este módulo. Viven en archivos propios para que las
// rutas puedan usarlos sin importar app.ts (sería una dependencia
// circular -- `no-circular` en .dependency-cruiser.js).
export { requireAuth } from './auth.js';
export { ErrorResponse, type ErrorResponseType } from './errors.js';

export interface BuildAppOptions {
  onRoute?: (routeOptions: RouteOptions) => void;
  // Casos de uso ya construidos. Si se omite, se usan los reales de
  // src/composition.ts (Postgres); los tests pasan dobles en memoria.
  useCases?: UseCases;
}

export async function buildApp(options: BuildAppOptions = {}): Promise<FastifyInstance> {
  const app = Fastify({
    logger: false,
  }).withTypeProvider<TypeBoxTypeProvider>();

  if (options.onRoute) {
    app.addHook('onRoute', options.onRoute);
  }

  const useCases = options.useCases ?? buildUseCases();

  // Todo error sale con la forma de ErrorResponse, la misma que documenta
  // el contrato OpenAPI. Sin esto, un error de validación de Fastify usa
  // su propio formato y un error inesperado filtra su mensaje interno.
  app.setErrorHandler<Error & { statusCode?: number }>(async (error, request, reply) => {
    const status = error.statusCode ?? 500;
    if (status >= 400 && status < 500) {
      return reply.status(status).send({ error: error.message });
    }
    request.log.error(error);
    return reply.status(500).send({ error: 'Internal Server Error' });
  });

  // 1. Configuración de OpenAPI / Swagger
  await app.register(swagger, {
    openapi: {
      info: {
        title: '{{ project_name }} API',
        version: '0.1.0',
      },
      components: {
        securitySchemes: {
          bearerAuth: {
            type: 'http',
            scheme: 'bearer',
            bearerFormat: 'JWT',
          },
        },
      },
    },
  });

  await app.register(swaggerUi, {
    routePrefix: '/docs',
  });

  // 2. Exposición del esquema OpenAPI en JSON crudo
  app.get(
    '/openapi.json',
    {
      config: { isPublic: true },
      schema: {
        description: 'Especificación OpenAPI 3.0 del sistema en formato JSON',
      },
    },
    () => app.swagger()
  );

  // 3. Ruta Pública Explícita (Health Check)
  app.get(
    '/health',
    {
      config: { isPublic: true },
      schema: {
        description: 'Endpoint de salud del sistema',
        response: {
          200: Type.Object(
            { status: Type.String() },
            { additionalProperties: false }
          ),
        },
      },
    },
    () => ({ status: 'ok' })
  );

  // 4. Ruta Protegida con contrato 200 y 401 documentado
  app.get(
    '/api/v1/profile',
    {
      preHandler: [requireAuth],
      schema: {
        description: 'Perfil de usuario autenticado',
        security: [{ bearerAuth: [] }],
        response: {
          200: Type.Object(
            { message: Type.String() },
            { additionalProperties: false }
          ),
          401: ErrorResponse,
        },
      },
    },
    () => ({ message: 'Acceso autorizado' })
  );

  // 5. Feature de referencia (tareas): src/http/routes/tasks.ts
  await app.register(taskRoutes, { useCases });

  return app;
}
