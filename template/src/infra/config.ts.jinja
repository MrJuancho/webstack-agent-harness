import { config as loadDotenv } from 'dotenv';
import { JWT_SECRET_MIN_LENGTH } from './auth/jwt-verifier.js';

// Toda variable de entorno que lee la app se valida ACÁ, una vez, al
// arrancar -- y si algo está mal se informan todos los problemas juntos,
// no el primero. La alternativa (leer `process.env.X ?? default` donde se
// necesita) deja que `PORT=abc` se convierta en NaN, o que producción
// arranque apuntando a la base local por defecto, sin que nada avise.

export type Env = Readonly<Record<string, string | undefined>>;

export const NODE_ENVS = ['development', 'test', 'production'] as const;
export type NodeEnv = (typeof NODE_ENVS)[number];

export const LOG_LEVELS = ['fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent'] as const;
export type LogLevel = (typeof LOG_LEVELS)[number];

export interface DatabaseConfig {
  readonly url: string;
}

export interface ServerConfig {
  readonly nodeEnv: NodeEnv;
  readonly host: string;
  readonly port: number;
  readonly logLevel: LogLevel;
  readonly jwtSecret: string;
  readonly database: DatabaseConfig;
}

export class ConfigError extends Error {
  readonly problems: readonly string[];

  constructor(problems: readonly string[]) {
    super(
      `Configuración inválida (${problems.length} problema(s)):\n${problems.map((problem) => `  - ${problem}`).join('\n')}`
    );
    this.name = 'ConfigError';
    this.problems = problems;
  }
}

// .env primero, .env.local encima: PG_PORT/JWT_SECRET son específicos de
// este worktree (scripts/worktree-env.sh) y tienen prioridad. Las
// variables ya definidas en el entorno real ganan sobre .env -- así
// producción se configura por entorno, sin archivos.
export function loadEnvFiles(): void {
  loadDotenv();
  loadDotenv({ path: '.env.local', override: true });
}

function isOneOf<T extends string>(values: readonly T[], value: string): value is T {
  return (values as readonly string[]).includes(value);
}

function readNodeEnv(env: Env, problems: string[]): NodeEnv {
  const value = env.NODE_ENV ?? 'development';
  if (isOneOf(NODE_ENVS, value)) {
    return value;
  }
  problems.push(`NODE_ENV="${value}" no es válido; opciones: ${NODE_ENVS.join(', ')}.`);
  return 'development';
}

function readPort(name: string, value: string, problems: string[]): number {
  const port = /^\d+$/.test(value) ? Number(value) : NaN;
  if (Number.isInteger(port) && port <= 65535) {
    return port;
  }
  problems.push(`${name}="${value}" no es un puerto válido (entero entre 0 y 65535).`);
  return 0;
}

function readDatabaseUrl(env: Env, nodeEnv: NodeEnv, problems: string[]): string {
  const url = env.DATABASE_URL;
  if (url !== undefined && url.length > 0) {
    if (!/^postgres(ql)?:\/\//.test(url)) {
      problems.push('DATABASE_URL debe empezar con postgres:// o postgresql://.');
    }
    return url;
  }
  if (nodeEnv === 'production') {
    // Sin esto, producción caería en silencio al Postgres local por
    // defecto de abajo (usuario y clave "postgres").
    problems.push('DATABASE_URL es obligatorio con NODE_ENV=production.');
    return '';
  }
  const pgPort = readPort('PG_PORT', env.PG_PORT ?? '5432', problems);
  return `postgres://postgres:postgres@127.0.0.1:${pgPort}/{{ db_name }}`;
}

// Para migrate/seed/el cliente: solo lo que hace falta para llegar a la
// base. No exige JWT_SECRET -- correr migraciones no necesita autenticar
// requests.
export function readDatabaseConfig(env: Env): DatabaseConfig {
  const problems: string[] = [];
  const nodeEnv = readNodeEnv(env, problems);
  const url = readDatabaseUrl(env, nodeEnv, problems);
  if (problems.length > 0) {
    throw new ConfigError(problems);
  }
  return { url };
}

export function readServerConfig(env: Env): ServerConfig {
  const problems: string[] = [];
  const nodeEnv = readNodeEnv(env, problems);
  const url = readDatabaseUrl(env, nodeEnv, problems);
  const port = readPort('PORT', env.PORT ?? '3000', problems);

  // Con NODE_ENV=test (Vitest lo define) el default es no loguear, para
  // no ensuciar la salida de los tests; LOG_LEVEL explícito siempre gana.
  const logLevelValue = env.LOG_LEVEL ?? (nodeEnv === 'test' ? 'silent' : 'info');
  let logLevel: LogLevel = 'info';
  if (isOneOf(LOG_LEVELS, logLevelValue)) {
    logLevel = logLevelValue;
  } else {
    problems.push(`LOG_LEVEL="${logLevelValue}" no es válido; opciones: ${LOG_LEVELS.join(', ')}.`);
  }

  const jwtSecret = env.JWT_SECRET ?? '';
  if (jwtSecret.length === 0) {
    problems.push(
      'JWT_SECRET no está definido. En local, correr `bash scripts/worktree-env.sh` (lo genera en .env.local); en producción, definirlo en el entorno.'
    );
  } else if (jwtSecret.length < JWT_SECRET_MIN_LENGTH) {
    problems.push(
      `JWT_SECRET tiene ${jwtSecret.length} caracteres; el mínimo es ${JWT_SECRET_MIN_LENGTH}.`
    );
  }

  if (problems.length > 0) {
    throw new ConfigError(problems);
  }
  return {
    nodeEnv,
    host: env.HOST ?? '0.0.0.0',
    port,
    logLevel,
    jwtSecret,
    database: { url },
  };
}
