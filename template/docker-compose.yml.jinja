name: {{ package_name }}

services:
  postgres:
    image: postgres:16-alpine
    container_name: {{ package_name }}-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ db_name }}
    tmpfs:
      - /var/lib/postgresql/data:rw,noexec,nosuid,size=512m
    ports:
      - "5432:5432"
