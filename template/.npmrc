# pnpm's default "isolated" node_modules layout breaks Stryker's plugin
# discovery: @stryker-mutator/core resolves "@stryker-mutator/*" plugins
# (like @stryker-mutator/vitest-runner) relative to ITS OWN private
# node_modules view, which under isolated linking only contains core's own
# declared dependencies -- not sibling devDependencies of the project.
# Confirmed by hand: with the default linker, `pnpm run mutate:full`
# always fails with "Cannot find TestRunner plugin vitest. In fact, no
# TestRunner plugins were loaded", regardless of mutate scope or vitest
# config. `node-linker=hoisted` makes pnpm produce a flat node_modules
# (like npm/yarn classic), which fixes it. See
# https://stryker-mutator.io/docs/stryker-js/troubleshooting/ (pnpm
# section) for the upstream-documented cause.
node-linker=hoisted
