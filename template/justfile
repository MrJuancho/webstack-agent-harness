set shell := ["bash", "-euo", "pipefail", "-c"]

# Aislamiento por worktree: PG_PORT y COMPOSE_PROJECT_NAME viven en
# .env.local (scripts/worktree-env.sh los deriva del path del worktree).
# `just` los carga como variables de entorno para toda receta -- incluidos
# los `docker compose` de más abajo y los scripts bash que invocan -- sin
# necesitar `-p` explícito ni volver a leer el archivo en cada script.
set dotenv-filename := ".env.local"
set dotenv-load := true

default:
    @just --list

# Inicialización determinista del entorno para nuevos clones o agentes
setup:
    bash scripts/worktree-env.sh
    just doctor
    pnpm install --frozen-lockfile
    just install-hooks
    just db-reset
    just gauntlet
    @echo "✔ Entorno completamente inicializado y verificado en verde."

# Instala el git pre-commit hook (Capa 2) en este clon local
install-hooks:
    cp scripts/hooks/pre-commit.sh .git/hooks/pre-commit
    chmod +x .git/hooks/pre-commit
    @echo "✔ Pre-commit hook instalado (Capa 2 activa)."

# Diagnóstico fail-closed de herramientas
doctor:
    bash scripts/doctor.sh

# Nivel 1: Hook de agente / pre-commit (<5s)
gauntlet-fast:
    @command -v pnpm >/dev/null 2>&1 || (echo "ERROR: pnpm ausente" && exit 1)
    @command -v gitleaks >/dev/null 2>&1 || (echo "ERROR: gitleaks ausente" && exit 1)
    gitleaks protect --staged --verbose
    pnpm run typecheck
    pnpm run lint
    pnpm run test:unit
    just test-domain
    just check-suppressions

# Suite de dominio puro (src/domain/**/*.test.ts): sin Postgres, sin
# globalSetup -- ver AGENTS.md, "Convención de capas". La misma config
# (vitest.config.domain.ts) que usa Stryker para mutar rápido.
test-domain:
    pnpm run test:domain

# Gate 9: toda supresión en src/domain/ -- de Stryker (`// Stryker
# disable ...`) o de la regla ESLint de determinismo (`// eslint-disable
# ... no-restricted-syntax`) -- debe llevar su justificación en la misma
# línea, o es la salida de emergencia más obvia para ponerse en verde sin
# resolver nada. Una sola implementación cubre ambos casos: Stryker usa
# `: razón`; ESLint usa la sintaxis de descripción que la propia
# herramienta reconoce, `-- razón` (`:` NO sirve para ESLint -- lo
# "justifica" pero no lo suprime: ESLint intenta resolver
# "no-restricted-syntax: razón" como nombre de regla, falla, y el error
# original queda sin suprimir además de sumar uno nuevo -- confirmado a
# mano, no es una suposición).
check-suppressions:
    #!/usr/bin/env bash
    set -euo pipefail
    UNJUSTIFIED=$(grep -rnP \
      '(Stryker disable(?!.*:\s*\S))|(eslint-disable[a-zA-Z-]*\s+no-restricted-syntax(?!.*--\s*\S))' \
      src/domain/ 2>/dev/null || true)
    if [ -n "$UNJUSTIFIED" ]; then
      echo "ERROR Gate 9: supresión sin justificación -- Stryker necesita ': razón', eslint-disable necesita '-- razón', en la misma línea:" >&2
      echo "$UNJUSTIFIED" >&2
      exit 1
    fi
    echo "✔ Gate 9: todas las supresiones (Stryker + ESLint) están justificadas."

# Nivel 2: Verificación estructural, arquitectura, deriva, migraciones e integración
gauntlet: gauntlet-fast
    pnpm run lint:arch
    just db-up
    pnpm run db:migrate
    just db-drift-check
    just db-migrate-reversible
    pnpm exec vitest run tests/architecture
    pnpm run test:integration

# Nivel 3: Pre-merge y CI (Property testing, Contratos, Seeds, Hold-outs y Mutation)
gauntlet-full: gauntlet
    pnpm run test:property
    just test-contracts
    just db-seed-check
    just test-holdouts
    pnpm run mutate:diff

# Nivel 4: Auditoría nocturna exhaustiva -- mutación completa (no solo el
# diff) del dominio puro. `incremental` en stryker.config.mjs solo ayuda
# en local: en CI (runner limpio en cada corrida) esto siempre corre
# completo, ver AGENTS.md.
audit:
    pnpm run mutate:full

# Infraestructura y Base de Datos (namespacing vía COMPOSE_PROJECT_NAME en
# .env.local -- un proyecto de Compose distinto por worktree, ver arriba)
db-up:
    docker compose up -d
    @docker compose exec -T postgres pg_isready -U postgres -d __DB_NAME__ || (echo "Esperando a postgres..." && sleep 2)

db-down:
    docker compose down

db-reset:
    just db-up
    @docker compose exec -T postgres psql -U postgres -c "DROP DATABASE IF EXISTS __DB_NAME__;" >/dev/null
    @docker compose exec -T postgres psql -U postgres -c "CREATE DATABASE __DB_NAME__;" >/dev/null
    pnpm run db:migrate

db-generate:
    pnpm exec drizzle-kit generate

db-drift-check:
    bash scripts/test-db-drift.sh

db-migrate-reversible:
    just db-up
    bash scripts/test-migrations-reversible.sh

db-seed-check:
    just db-up
    bash scripts/test-seed-determinism.sh

test-contracts:
    @command -v docker >/dev/null 2>&1 || (echo "ERROR: Docker ausente" && exit 1)
    bash scripts/test-contracts.sh

test-holdouts:
    bash scripts/test-holdouts.sh

# RUTA EXCLUSIVA HUMANA: Sellado de suite hold-out
seal-holdouts:
    @echo "==> ATENCIÓN: Sellando tests hold-out con firma SHA-256..."
    find tests/holdout -type f -name "*.ts" | sort | xargs sha256sum > .holdout.sha256
    @echo "✔ Sello actualizado en .holdout.sha256"

# Orquestación de Worktrees de Revisión
review-start BRANCH="HEAD":
    @git worktree remove ../reviewer-workspace --force 2>/dev/null || true
    @rm -rf ../reviewer-workspace
    @git worktree prune
    git worktree add --detach ../reviewer-workspace {{BRANCH}}
    cd ../reviewer-workspace && pnpm install --frozen-lockfile
    @echo "✔ Worktree de revisión listo en ../reviewer-workspace"

review-clean:
    git worktree remove ../reviewer-workspace --force 2>/dev/null || true
    @rm -rf ../reviewer-workspace
    git worktree prune
    @echo "✔ Worktree de revisión desmontado y podado"
