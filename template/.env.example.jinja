# DATABASE_URL es opcional: si no se define, el código la arma solo con
# PG_PORT (leído de .env.local, específico de este worktree -- ver
# scripts/worktree-env.sh). No hardcodear el puerto acá salvo que de
# verdad quieras apuntar a un Postgres distinto al de este worktree.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{ db_name }}
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/{{ db_name }}_test
NODE_ENV=development

# JWT_SECRET firma y verifica los tokens de acceso (HS256). Obligatorio,
# mínimo 32 caracteres: sin él el servidor no arranca. En local NO va acá:
# scripts/worktree-env.sh genera uno aleatorio en .env.local. En
# producción, definirlo en el entorno del despliegue (nunca en git).
# JWT_SECRET=
